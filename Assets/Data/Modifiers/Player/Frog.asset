  _interactions:
  - WithModifier: {fileID: 0}
    WithEnvironment: Trampoline
    Expected: "Bounce stacks with the surface \u2014 clears heights nothing else
      reaches."
  - WithModifier: {fileID: 0}
    WithEnvironment: LowGravity
    Expected: Long floaty arcs; the bounce carries much further per hop.
  - WithModifier: {fileID: 0}
    WithEnvironment: Sticky
    Expected: Sticky floor kills the bounce, so it becomes a trap for Frog.
