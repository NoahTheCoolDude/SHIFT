  m_Script: {fileID: 11500000, guid: 267d2c858c15f9549918d5774780574c, type: 3}
  m_Name: Frog
  m_EditorClassIdentifier: Assembly-CSharp::Shift.Modifiers.ModifierDefinition
  _displayName: Frog
  _tint: {r: 0.35, g: 0.78, b: 0.35, a: 1}
  _override:
    Set: 4
    Mass: 2
    Friction: 0.6
    Bounce: 0.9
    GravityDirection: {x: 0, y: -1, z: 0}
    GravityStrength: 1
    Adhesion: 0
    Ghost: 0
